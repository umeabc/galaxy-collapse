# server
PORT=3100
HOST=127.0.0.1

# data
DATA_DIR=./data
DB_PATH=./data/galaxy.sqlite

# Bilibili：订阅账号请在 WebUI「设置 → 订阅账号」添加（支持多个）。
# 下面两项仅用于旧版单账号配置：首次启动会自动迁移成一个「从现在开始」的订阅。
BILI_USER_MID=
BILI_USER_NAME=
# dynamic | article（仅迁移时使用）
BILI_SOURCE_MODE=dynamic
# 可选：Netscape 格式 cookie 文件。匿名亦可抓取公开动态/专栏，配置后更稳定。
BILI_COOKIE_FILE=

# GameKee：发布必须提供登录 cookie。
# 方式一（推荐）：设置页直接粘贴 `userToken=...; userUid=...; obs_client_params=...`
# 方式二：Netscape cookie 文件（包含 userToken / userUid / obs_client_params）
GAMEKEE_COOKIE_FILE=
# 可选：直接以环境变量提供 cookie 文本（一般用设置页即可）
GAMEKEE_COOKIE_TEXT=
GAMEKEE_BASE_URL=https://www.gamekee.com
GAMEKEE_GAME_ID=829
GAMEKEE_GAME_ALIAS=ba
PUBLISH_TIMEOUT_MS=20000
MAX_TITLE_LENGTH=100

# AI 审核（OpenAI 兼容 /chat/completions；留空则只用关键字审核）
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_MIN_CONFIDENCE=0.6
